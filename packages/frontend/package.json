    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "sass-embedded": "^1.99.0",
    "typescript": "^6.0.3",
    "vite": "^6.2.3",
    "vite-plugin-comlink": "^5.1.0"
