{
  "name": "@sf-girls-calculator/calculator",
  "author": "ox7f",
  "version": "0.0.1",
  "description": "math stuff",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint ./calculator/**/*",
    "typecheck": "tsc -b",
    "format": "prettier --write calculator"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "typescript": "^5.9.3"
  },
  "source": "calculator/index.ts",
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "printWidth": 120
  },
  "private": true
}
