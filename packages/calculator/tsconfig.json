{
  "compilerOptions": {
    "experimentalDecorators": true,
    "outDir": "dist",
    "module": "esnext",
    "target": "es2017",
    "lib": ["es2019", "dom"],
    "sourceMap": true,
    "allowJs": true,
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "rootDir": "calculator",
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "removeComments": true,
    "declaration": true,
  },
  "exclude": [
    "dist",
    "node_modules",
    "eslint.config.js",
  ]
}
